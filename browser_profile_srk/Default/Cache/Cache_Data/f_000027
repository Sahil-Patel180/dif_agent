  <script type="text/javascript">
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/service-worker.js').then(function (registration) {
        console.log('ServiceWorker registration successful with scope: ', registration.scope);
      });
    }

    function getBrowerInfo() {
      var browserDtl = {
        name: '',
        version: '',
        GMT: '',
        geolocation: null
      };
      var ua = navigator.userAgent;
      var tem;
      var M = ua.match(/(opera|chrome|safari|firefox|msie|edge|trident(?=\/))\/?\s*(\d+)/i) || [];
      if (/trident/i.test(M[1])) {
        tem = /\brv[ :]+(\d+)/g.exec(ua) || [];
        browserDtl.name = 'IE';
        browserDtl.version = tem[1] || '';
        return browserDtl;
      }
      if (M[1] === 'Chrome') {
        tem = ua.match(/\bOPR\/(\d+)/);
        if (tem != null) {
          browserDtl.name = 'Opera';
          browserDtl.version = tem[1] || '';
          return browserDtl;
        }
        tem = ua.match(/\bEdge\/(\d+)/);
        if (tem != null) {
          browserDtl.name = 'Edge';
          browserDtl.version = tem[1] || '';
          return browserDtl;
        }
      }
      M = M[2] ? [M[1], M[2]] : [navigator.appName, navigator.appVersion, '-?'];
      if ((tem = ua.match(/version\/(\d+)/i)) != null) {
        M.splice(1, 1, tem[1]);
      }
      var date = new Date();
      browserDtl.GMT = date.getTimezoneOffset();
      browserDtl.geolocation = navigator.geolocation ? navigator.geolocation : null;
      browserDtl.name = M[0];
      browserDtl.version = M[1];
      return browserDtl;
    }

    var browserDtl = getBrowerInfo();
    var browserName = browserDtl.name;
    var browserVersion = browserDtl.version;
    console.log("BROWSER NAME", browserName, browserDtl);
    if (((browserName.toUpperCase() == 'IE' || browserName.toUpperCase() == 'MSIE') && browserVersion < 11) ||
      (browserName.toUpperCase() == 'FIREFOX' && browserDtl.GMT === 0 && browserDtl.geolocation === null)) {
      var appRoot = document.getElementsByTagName('app-root');
      appRoot[0].style.display = 'block';
      appRoot[0].style.opacity = '.7';
      var overlay = document.getElementById('landingPageOverlay');
      overlay.style.display = 'block';
    }
  </script>
